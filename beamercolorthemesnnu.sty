% SNNU (Shaanxi Normal University) color theme for Beamer
% Palette based on the university's deep red (绛红) with cherry red accents.

\mode<presentation>

\definecolor{snnudarkred}{RGB}{139,31,44}    % 绛红 maroon,主色
\definecolor{snnured}{RGB}{163,48,60}        % 深红
\definecolor{snnupalered}{RGB}{211,122,130}  % 浅红
\definecolor{snnucherry}{RGB}{210,4,45}      % 樱桃红,点缀色

\setbeamercolor{alerted text}{fg=snnucherry}
\setbeamercolor*{palette primary}{bg=snnudarkred,fg=white}
\setbeamercolor*{palette secondary}{fg=white,bg=snnupalered}
\setbeamercolor*{palette tertiary}{fg=white,bg=snnured}
\setbeamercolor*{palette quaternary}{fg=white,bg=snnucherry}
\setbeamercolor*{structure}{fg=snnudarkred,bg=white}
\setbeamercolor{frametitle}{bg=snnudarkred,fg=white}

\mode<all>
